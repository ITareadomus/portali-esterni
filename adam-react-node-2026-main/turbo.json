{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/prisma/**"],
      "env": [
        "DATABASE_URL",
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME"
      ]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "API_INTERNAL_URL",
        "CORS_ORIGIN",
        "API_DOCS_ENABLED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prepare:dev": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^build"],
      "env": [
        "DATABASE_URL",
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "API_INTERNAL_URL"
      ]
    }
  }
}
