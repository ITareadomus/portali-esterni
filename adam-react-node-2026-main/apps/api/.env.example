NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_DOCS_ENABLED=true

DATABASE_URL="mysql://react_base:react_base@127.0.0.1:3306/react_base"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=react_base
DB_PASSWORD=react_base
DB_NAME=react_base

# Future Better Auth runtime configuration.
# Keep these values backend-only.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Customer/clienti legacy login. Backend-only.
CUSTOMER_AUTH_SECRET=replace-with-at-least-32-characters
CUSTOMER_AUTH_TENANT_ID=1
CUSTOMER_AUTH_SESSION_HOURS=12
CUSTOMER_AUTH_REMEMBER_DAYS=30

# Bootstrap-only values; keep real values backend-only.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-8-characters
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_LEGACY_TENANT_ID=1
BOOTSTRAP_LEGACY_ORGANIZATION_NAME=ADAM Legacy
BOOTSTRAP_LEGACY_ORGANIZATION_SLUG=adam-legacy
