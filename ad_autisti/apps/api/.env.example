NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
API_DOCS_ENABLED=true

DATABASE_URL="mysql://doadmin:password@db-mysql-host:25060/adam_dev?sslaccept=strict"
DB_HOST=db-mysql-host
DB_PORT=25060
DB_USER=doadmin
DB_PASSWORD=password
DB_NAME=adam_dev
DB_SSL=true

# Future Better Auth runtime configuration.
# Keep these values backend-only.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Customer/clienti legacy login. Backend-only.
CUSTOMER_AUTH_SECRET=replace-with-at-least-32-characters
CUSTOMER_AUTH_TENANT_ID=1
CUSTOMER_AUTH_SESSION_HOURS=12
CUSTOMER_AUTH_REMEMBER_DAYS=30

# Logistics Postgres for lg_drivers / lg_timeline / lg_driver_credentials.
LOGISTICS_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/defaultdb_dev?sslmode=require"

# Driver/autisti portal: van login (ADP01/ADP02/ADP03) resolves today's driver via
# Postgres lg_selected_drivers.vehicle_assignments, then uses MySQL driven_by_us as before.
DRIVER_AUTH_SECRET=replace-with-at-least-32-characters
DRIVER_AUTH_SESSION_HOURS=12
DRIVER_AUTH_REMEMBER_DAYS=30
DRIVER_AUTH_ROLE_ID=9
# Driver/autisti portal: van login resolves stops via MySQL app_housekeeping.lg_vehicle
# (+ driven_by_us for the associated driver). Van list: apps/api/config/driver-vans.json
# Optional absolute/relative override:
# DRIVER_VAN_ACCOUNTS_PATH=config/driver-vans.json
BOOTSTRAP_DRIVER_ID=737
BOOTSTRAP_DRIVER_PASSWORD=replace-with-at-least-8-characters

# Bootstrap-only values; keep real values backend-only.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-8-characters
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_LEGACY_TENANT_ID=1
BOOTSTRAP_LEGACY_ORGANIZATION_NAME=ADAM Legacy
BOOTSTRAP_LEGACY_ORGANIZATION_SLUG=adam-legacy
