{
  "name": "@adam/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.json && node scripts/copy-prisma-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "pnpm run generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "mariadb": "3.5.2"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "prisma": "7.8.0",
    "typescript": "6.0.3"
  }
}
