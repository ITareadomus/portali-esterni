generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String           @id @db.VarChar(191)
  name          String           @db.VarChar(191)
  email         String           @db.VarChar(191)
  emailVerified Boolean
  image         String?          @db.Text
  role          String?          @db.VarChar(191)
  banned        Boolean?         @default(false)
  banReason     String?          @db.Text
  banExpires    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]     @relation("InvitationInviter")
  profiles      AdmUserProfile[]

  @@unique([email])
  @@map("adm_user")
}

model Session {
  id                   String        @id @db.VarChar(191)
  expiresAt            DateTime
  token                String        @db.VarChar(191)
  createdAt            DateTime
  updatedAt            DateTime
  ipAddress            String?       @db.VarChar(45)
  userAgent            String?       @db.Text
  userId               String        @db.VarChar(191)
  activeOrganizationId String?       @db.VarChar(191)
  impersonatedBy       String?       @db.VarChar(191)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@unique([token])
  @@index([activeOrganizationId])
  @@map("adm_session")
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(191)
  userId                String    @db.VarChar(191)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@map("adm_account")
}

model Verification {
  id         String    @id @db.VarChar(191)
  identifier String    @db.VarChar(191)
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("adm_verification")
}

model Organization {
  id             String            @id @db.VarChar(191)
  name           String            @db.VarChar(191)
  slug           String            @db.VarChar(191)
  logo           String?           @db.Text
  metadata       String?           @db.Text
  createdAt      DateTime
  sessions       Session[]
  members        Member[]
  invitations    Invitation[]
  tenantProfile  AdmTenantProfile?
  userProfiles   AdmUserProfile[]
  adamTenant     AdmTenant?

  @@unique([slug])
  @@map("adm_organization")
}

model Member {
  id             String       @id @db.VarChar(191)
  organizationId String       @db.VarChar(191)
  userId         String       @db.VarChar(191)
  role           String       @db.VarChar(191)
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("adm_member")
}

model Invitation {
  id             String       @id @db.VarChar(191)
  organizationId String       @db.VarChar(191)
  email          String       @db.VarChar(191)
  role           String?      @db.VarChar(191)
  status         String       @db.VarChar(32)
  expiresAt      DateTime
  inviterId      String       @db.VarChar(191)
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("adm_invitation")
}

model AdmTenantProfile {
  organizationId       String       @id @db.VarChar(191)
  tenantKind           String       @db.VarChar(32)
  legacyCustomerId     Int?         @db.UnsignedInt
  providedByEmployeeId Int?         @db.UnsignedInt
  subscriptionCode     String?      @db.VarChar(191)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legacyCustomer       AppCustomer? @relation(fields: [legacyCustomerId], references: [id], onDelete: SetNull)
  providedByEmployee   AppEmployee? @relation(fields: [providedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([legacyCustomerId])
  @@index([providedByEmployeeId])
  @@unique([subscriptionCode])
  @@map("adm_tenant_profile")
}

model AdmUserProfile {
  id             String       @id @db.VarChar(191)
  userId         String       @db.VarChar(191)
  organizationId String       @db.VarChar(191)
  profileType    String       @db.VarChar(32)
  employeeId     Int?         @db.UnsignedInt
  workerUserId   Int?         @db.UnsignedInt
  customerId     Int?         @db.UnsignedInt
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       AppEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  workerUser     AppUser?     @relation(fields: [workerUserId], references: [id], onDelete: SetNull)
  customer       AppCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([employeeId])
  @@index([workerUserId])
  @@index([customerId])
  @@unique([organizationId, employeeId])
  @@unique([organizationId, workerUserId])
  @@unique([organizationId, customerId])
  @@map("adm_user_profile")
}

model AppEmployee {
  id                     Int                @id @db.UnsignedInt
  admTenantId            Int                @default(1) @map("adm_tenant_id") @db.UnsignedInt
  admTenant              AdmTenant          @relation(fields: [admTenantId], references: [id], onDelete: Restrict)
  tenantProfilesProvided AdmTenantProfile[]
  userProfiles           AdmUserProfile[]

  @@index([admTenantId])
  @@map("app_employees")
}

model AppUser {
  id                       Int                @id @db.UnsignedInt
  name                     String?            @db.VarChar(255)
  lastname                 String?            @db.VarChar(255)
  email                    String?            @db.VarChar(255)
  mobile                   String?            @db.VarChar(255)
  phone                    String?            @db.VarChar(255)
  userRoleId               Int?               @map("user_role_id") @db.UnsignedInt
  active                   Int                @default(0) @db.TinyInt
  admTenantId              Int                @default(1) @map("adm_tenant_id") @db.UnsignedInt
  admTenant                AdmTenant          @relation(fields: [admTenantId], references: [id], onDelete: Restrict)
  userProfiles             AdmUserProfile[]
  housekeepingAssignments  AppHousekeeping[]  @relation("HousekeepingAssignedUser")

  @@index([admTenantId])
  @@index([email])
  @@index([userRoleId, active])
  @@map("app_users")
}

model AppCustomer {
  id             Int              @id @db.UnsignedInt
  name           String?          @db.VarChar(255)
  nameFrontend   String?          @map("name_frontend") @db.VarChar(255)
  email          String           @db.VarChar(255)
  password       String           @db.VarChar(255)
  rememberToken  String?          @map("remember_token") @db.VarChar(100)
  color          String?          @db.VarChar(16)
  active         Int              @default(0) @db.TinyInt
  deletedAt      DateTime?        @map("deleted_at")
  admTenantId    Int              @default(1) @map("adm_tenant_id") @db.UnsignedInt
  admTenant      AdmTenant        @relation(fields: [admTenantId], references: [id], onDelete: Restrict)
  tenantProfiles AdmTenantProfile[]
  userProfiles   AdmUserProfile[]
  rememberTokens AppCustomerRememberToken[]
  structures     AppStructure[]

  @@unique([email])
  @@index([admTenantId])
  @@map("app_customers")
}

model AppHousekeeping {
  id                 Int                     @id @default(autoincrement()) @db.UnsignedInt
  referenceId        String?                 @map("reference_id") @db.VarChar(32)
  structureId        Int                     @map("structure_id") @db.UnsignedInt
  operationId        Int?                    @default(0) @map("operation_id") @db.UnsignedInt
  activityId         Int?                    @default(0) @map("activity_id") @db.UnsignedInt
  checkout           DateTime?               @db.Date
  checkoutTime       String?                 @map("checkout_time") @db.VarChar(5)
  checkoutPax        Int                     @default(0) @map("checkout_pax") @db.UnsignedInt
  checkin            DateTime?               @db.Date
  checkinTime        String?                 @map("checkin_time") @db.VarChar(5)
  checkinPax         Int                     @default(0) @map("checkin_pax") @db.UnsignedInt
  notes              String?                 @db.Text
  noShow             Int                     @default(0) @map("no_show") @db.TinyInt
  deletedAtClient    DateTime?               @map("deleted_at_client")
  cleanedByUs        Int?                    @default(0) @map("cleaned_by_us") @db.UnsignedInt
  drivenByUs         Int                     @default(0) @map("driven_by_us")
  lgVehicle          Int                     @default(0) @map("lg_vehicle")
  lgSequence         Int                     @default(0) @map("lg_sequence")
  lgTravelTime       Int?                    @map("lg_travel_time")
  lgStartTime        DateTime?               @map("lg_start_time") @db.Time(0)
  lgEndTime          DateTime?               @map("lg_end_time") @db.Time(0)
  lgOperation        String?                 @map("lg_operation") @db.VarChar(10)
  startTime          DateTime?               @map("start_time") @db.Time(0)
  endTime            DateTime?               @map("end_time") @db.Time(0)
  realStart          DateTime?               @map("lg_real_start") @db.Time(0)
  realEnd            DateTime?               @map("lg_real_end") @db.Time(0)
  lgPaused           Int                     @default(0) @map("lg_paused") @db.TinyInt
  startwork          Int?                    @default(0) @db.TinyInt
  startworkAt        DateTime?               @map("startwork_at")
  startreport        Int?                    @default(0) @db.TinyInt
  startreportAt      DateTime?               @map("startreport_at")
  cleaned            Int?                    @default(0) @db.TinyInt
  closed             Int?                    @default(0) @db.TinyInt
  deleted            Int?                    @default(0) @db.TinyInt
  sequence           Int?                    @default(0)
  updatedAt          DateTime?               @map("updated_at")
  deletedAt          DateTime?               @map("deleted_at")
  structure          AppStructure            @relation(fields: [structureId], references: [id])
  operation          AppStructureOperation?   @relation(fields: [operationId], references: [id])
  activity           AppStructureActivity?    @relation(fields: [activityId], references: [id])
  assignedUser       AppUser?                 @relation("HousekeepingAssignedUser", fields: [cleanedByUs], references: [id])
  reports            AppHousekeepingReport[]

  @@index([checkout], map: "idx_housekeeping_checkout")
  @@index([cleaned, checkout, checkoutTime], map: "idx_housekeeping_cleaned_checkout")
  @@index([structureId], map: "idx_housekeeping_structure_id")
  @@index([cleanedByUs], map: "idx_housekeeping_cleaned_by_us")
  @@map("app_housekeeping")
}

model AppHousekeepingReport {
  id             Int             @id @default(autoincrement()) @db.UnsignedInt
  housekeepingId Int             @map("housekeeping_id") @db.UnsignedInt
  userId         Int             @map("user_id") @db.UnsignedInt
  deleted        Int             @default(0) @db.TinyInt
  deletedAt      DateTime?       @map("deleted_at")
  housekeeping   AppHousekeeping @relation(fields: [housekeepingId], references: [id])

  @@index([housekeepingId], map: "idx_housekeeping_report_housekeeping_id")
  @@map("app_housekeeping_report")
}

model AppStructure {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  customerId        Int                 @map("customer_id") @db.UnsignedInt
  structureKindId   Int?                @default(0) @map("structure_kind_id") @db.UnsignedInt
  structureTypeId   Int?                @default(0) @map("structure_type_id") @db.UnsignedInt
  aptCode           String              @map("apt_code") @db.VarChar(64)
  logisticCode      Int?                @map("logistic_code")
  name              String              @db.VarChar(255)
  nameFrontend      String?             @map("name_frontend") @db.VarChar(255)
  address1          String?             @db.VarChar(128)
  address2          String?             @db.VarChar(128)
  city              String?             @db.VarChar(64)
  postcode          String?             @db.VarChar(12)
  lat               String?             @db.VarChar(16)
  lng               String?             @db.VarChar(16)
  stateId           Int?                @default(0) @map("state_id") @db.UnsignedInt
  alertKeys         Int?                @default(0) @map("alert_keys") @db.TinyInt
  structureKeys     String?             @map("structure_keys") @db.MediumText
  singleSofabeds    Int?                @map("single_sofabeds")
  doubleSofabeds    Int?                @map("double_sofabeds")
  premium           Int?                @default(0) @db.TinyInt
  active            Int                 @db.TinyInt
  deletedAt         DateTime?           @map("deleted_at")
  customer          AppCustomer         @relation(fields: [customerId], references: [id])
  state             AppState?           @relation(fields: [stateId], references: [id])
  housekeepings     AppHousekeeping[]

  @@index([customerId], map: "customer_id")
  @@index([logisticCode])
  @@map("app_structures")
}

model AppStructureKey {
  id     BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name   String? @db.VarChar(32)
  label  String? @db.VarChar(32)
  active Int     @default(0) @db.TinyInt

  @@map("app_structure_keys")
}

model AppState {
  id         Int            @id @default(autoincrement()) @db.UnsignedInt
  isoCode    String?        @map("iso_code") @db.VarChar(7)
  structures AppStructure[]

  @@map("app_state")
}

model AppStructureOperation {
  id            Int                         @id @default(autoincrement()) @db.UnsignedInt
  active        Int                         @default(0) @db.TinyInt
  langs         AppStructureOperationLang[]
  housekeepings AppHousekeeping[]

  @@map("app_structure_operation")
}

model AppStructureOperationLang {
  structureOperationId Int                   @map("structure_operation_id") @db.UnsignedInt
  languageId           Int                   @map("id_lang") @db.UnsignedInt
  name                 String                @db.VarChar(128)
  operation            AppStructureOperation @relation(fields: [structureOperationId], references: [id], onDelete: Cascade)

  @@id([structureOperationId, languageId])
  @@index([languageId], map: "id_lang")
  @@map("app_structure_operation_langs")
}

model AppStructureActivity {
  id            Int                        @id @default(autoincrement()) @db.UnsignedInt
  active        Int                        @default(0) @db.TinyInt
  langs         AppStructureActivityLang[]
  housekeepings AppHousekeeping[]

  @@map("app_structure_activity")
}

model AppStructureActivityLang {
  structureActivityId Int                  @map("structure_activity_id") @db.UnsignedInt
  languageId          Int                  @map("id_lang") @db.UnsignedInt
  name                String               @db.VarChar(128)
  activity            AppStructureActivity @relation(fields: [structureActivityId], references: [id], onDelete: Cascade)

  @@id([structureActivityId, languageId])
  @@index([languageId], map: "id_lang")
  @@map("app_structure_activity_langs")
}

model AppSetting {
  id     Int     @id @default(autoincrement()) @db.UnsignedInt
  key    String  @unique @db.VarChar(255)
  value  String? @db.Text
  active Int     @db.TinyInt

  @@map("app_settings")
}

model AppCustomerRememberToken {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  customerId    Int         @map("customer_id") @db.UnsignedInt
  admTenantId   Int         @map("adm_tenant_id") @db.UnsignedInt
  selector      String      @unique @db.Char(43)
  tokenHash     String      @map("token_hash") @db.Char(64)
  userAgentHash String?     @map("user_agent_hash") @db.Char(64)
  ipHash        String?     @map("ip_hash") @db.Char(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt    DateTime?   @map("last_used_at") @db.DateTime(3)
  expiresAt     DateTime    @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime?   @map("revoked_at") @db.DateTime(3)
  customer      AppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  admTenant     AdmTenant   @relation(fields: [admTenantId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([admTenantId, customerId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("app_customer_remember_tokens")
}

model AdmTenant {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  name           String        @db.VarChar(191)
  slug           String        @db.VarChar(191)
  organizationId String?       @unique @db.VarChar(191)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employees      AppEmployee[]
  users          AppUser[]
  customers      AppCustomer[]
  customerRememberTokens AppCustomerRememberToken[]

  @@unique([slug])
  @@map("adm_tenant")
}
